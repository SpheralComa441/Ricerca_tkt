{
  "manifest_version": 3,
  "name": "Ricerca TKT",
  "short_name": "Ricerca TKT",
  "version": "5.2.1",
  "description": "Ricerca avanzata e lettura chiara di Ticket, Knowledge Base e FAQ di HDA TOUCH, Vecchio Cruscotto e Ricerca avanzata, con tema scuro/chiaro e aggiornamenti automatici.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Apri Ricerca TKT", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "webRequest", "scripting", "alarms", "nativeMessaging"],
  "host_permissions": [
    "https://zucchetti.support/*",
    "https://*.zucchetti.it/*",
    "https://github.com/SpheralComa441/Ricerca_tkt/*",
    "https://raw.githubusercontent.com/SpheralComa441/Ricerca_tkt/*",
    "https://codeload.github.com/SpheralComa441/Ricerca_tkt/*",
    "https://api.github.com/repos/SpheralComa441/Ricerca_tkt/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://zucchetti.support/HDAPortal/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zucchetti.it/areariservata/*"],
      "js": ["content/ar_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Apri Ricerca TKT" }
  }
}
