{
  "manifest_version": 3,
  "name": "Ricerca TKT",
  "short_name": "Ricerca TKT",
  "version": "4.3.0",
  "description": "Ricerca avanzata e lettura chiara dei ticket di HDA TOUCH e del Vecchio Cruscotto Zucchetti, con archivio locale ricercabile.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Apri Ricerca TKT", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "webRequest", "scripting"],
  "host_permissions": ["https://zucchetti.support/*", "https://*.zucchetti.it/*"],
  "content_scripts": [
    {
      "matches": ["https://zucchetti.support/HDAPortal/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.zucchetti.it/areariservata/*"],
      "js": ["content/ar_bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+T" }, "description": "Apri Ricerca TKT" }
  }
}
