# Connettori abilitati (separati da virgola): zucchetti, demo
CONNECTORS=zucchetti,demo
# In produzione dietro HTTPS: 1
COOKIE_SECURE=0
# Minuti di inattività prima della scadenza della sessione
SESSION_IDLE_MINUTES=480
# Se valorizzato, solo questi utenti Zucchetti possono accedere (separati da virgola)
ALLOWED_USERS=
# Pagina Diagnostica (importazione cURL, risposta grezza). Attivala solo per la configurazione iniziale.
APP_DIAGNOSTICS=0
# Cartella dati (database SQLite, modello di richiesta importato)
DATA_DIR=./data
# Durata cache risultati per utente (secondi)
CACHE_TTL_SECONDS=600
# Dimensione e latenza simulata dell'archivio demo
DEMO_SIZE=40000
DEMO_LATENCY_MS=250
HOST=127.0.0.1
PORT=8000
